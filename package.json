{
  "name": "dhm-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "DHM Guide Website - Deployment trigger 2025-01-05",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-posts.js && node scripts/generate-blog-canonicals.js && node scripts/generate-sitemap.js && vite build && node scripts/verify-z-classes.mjs && node scripts/prerender-blog-posts-enhanced.js && node scripts/prerender-main-pages.js && npm run test:dist",
    "lint": "eslint .",
    "lint:modern": "eslint src/components/modern \"src/pages/*.modern.jsx\" \"src/pages/*Route.jsx\" \"src/newblog/pages/*.modern.jsx\" src/hooks/useVariant.js src/hooks/useFeatureFlag.js src/lib/experiment.js src/lib/experimentOverride.js src/lib/cachedFlags.js src/lib/preloadModernFonts.js src/lib/__tests__ src/hooks/__tests__ src/pages/__tests__ src/components/modern/__tests__",
    "preview": "vite preview",
    "verify-registry": "node verify-registry.js",
    "generate-registry": "node generate-registry.js",
    "validate-posts": "node scripts/validate-posts.js",
    "prebuild": "node verify-registry.js && node scripts/validate-posts.js",
    "analyze-links": "node scripts/analyze-internal-links.js",
    "seo-metrics": "node scripts/analyze-internal-links.js",
    "test": "node scripts/check-affiliate-links.mjs && vitest run",
    "test:dist": "vitest run --config vitest.dist.config.js",
    "check-affiliate-links": "node scripts/check-affiliate-links.mjs --resolve",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:visual:update": "playwright test --config=playwright.visual.config.js --update-snapshots"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.72.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "playwright": "^1.65.1",
    "posthog-js": "^1.455.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "imagemin": "^9.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "jsdom": "^26.1.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.34.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.4.6",
    "vite-plugin-imagemin": "^0.6.1",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.9"
}
